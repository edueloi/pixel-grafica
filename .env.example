# Banco (container Docker: npm run db:up)
DATABASE_URL="mysql://pixel:pixel@localhost:3307/pixel_grafica"

# API
PORT=3100
JWT_SECRET="troque-por-um-valor-longo-e-aleatorio"
# Chave para criptografar segredos salvos pelo painel (ex.: chave do Gemini)
APP_SECRETS_ENCRYPTION_KEY="troque-por-um-valor-longo-e-aleatorio"

# Primeiro acesso (criado pelo seed)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@pixelgrafica.com.br"
ADMIN_PASSWORD="Admin@123"

# IA (opcional aqui: também dá para cadastrar em Bot > Inteligência)
GEMINI_API_KEY=""

# WhatsApp: em produção roda num processo próprio (npm run wpp) para reiniciar a API sem derrubar a conexão.
# Em desenvolvimento deixe WA_WORKER_URL vazio: tudo roda no mesmo processo.
WA_WORKER_URL=""
WA_WORKER_PORT=3107
WA_INTERNAL_TOKEN="troque-este-token"
